@echo off
:: 切換編碼為 UTF-8，避免命令提示字元出現中文亂碼
chcp 65001 >nul

echo ========================================
echo 🚀 準備開始自動同步至 GitHub...
echo ========================================

:: 1. 將所有變更加入追蹤清單
git add .

:: 2. 自動將目前的「日期與時間」作為 Commit 註解
git commit -m "Auto Backup: %date% %time%"

:: 3. 推送上雲端
git push

echo ========================================
echo ✨ GitHub 同步完成！你可以關閉這個視窗了。
echo ========================================
pause